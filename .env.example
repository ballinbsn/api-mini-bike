# Copie este arquivo para ".env" (uso local) e/ou configure os mesmos nomes
# no painel do Railway (produção).
# NUNCA suba o arquivo ".env" pro GitHub nem cole essas chaves em chat/mensagem.

# Chave pública da OnyxPag (painel OnyxPag > Chaves de API)
ONYXPAG_PUBLIC_KEY=coloque_sua_chave_publica_aqui

# Chave privada da OnyxPag (painel OnyxPag > Chaves de API)
ONYXPAG_PRIVATE_KEY=coloque_sua_chave_privada_aqui

# URL pública do webhook depois de publicado no Railway. É pra essa URL que a
# OnyxPag avisa (postbackUrl) quando um Pix muda de status. Se o painel da
# OnyxPag também tiver um cadastro de webhook separado (aba "Webhooks"),
# registre esse MESMO endereço lá também — não é a mesma coisa que o token
# da UTMify abaixo, são hops diferentes.
ONYXPAG_WEBHOOK_URL=https://SEU-BACKEND-NO-RAILWAY/api/webhooks/onyxpag

# Token da API da UTMify. Pegue em: UTMify > aba "Webhooks" > card da DIREITA
# "Credenciais de API" > "Adicionar Credencial". NÃO é o card da esquerda
# ("Webhooks" / "Adicionar Webhook") — aquele é pra outra coisa.
# Com esse token, o backend registra a venda na UTMify: "waiting_payment"
# quando o Pix é gerado e "paid" quando cai o pagamento — assim a campanha
# marca a venda e o Meta só recebe Purchase no pago.
# Sem esse token, a integração é ignorada (o checkout continua funcionando).
UTMIFY_API_TOKEN=coloque_seu_token_utmify_aqui

# Domínio(s) onde a página de checkout fica publicada, separados por vírgula.
# Opcional — sem isso a API aceita requisição de qualquer origem.
CORS_ORIGIN=https://seudominio.com,https://www.seudominio.com

# Porta local (o Railway define a dele automaticamente, não precisa mexer)
PORT=3000
